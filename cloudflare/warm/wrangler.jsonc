// Keeps Dumbledore awake: a cron-only Worker (free plan) that wakes the agent on Vercel every 4 minutes. See worker.ts.
// No routes and no URL: nothing can call it from outside. Deploy: npm run warm:deploy
{
  "name": "rishabh-warm",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "triggers": { "crons": ["*/4 * * * *"] },
  "vars": { "SITE_ORIGIN": "https://rishabh-hota.vercel.app" },
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false }
}
