{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "content": "tsx scripts/build-content.ts",
    "predev": "npm run content",
    "dev": "next dev",
    "prebuild": "npm run content && node --import tsx scripts/ingest.ts --if-configured",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "ingest": "npm run content && node --env-file-if-exists=.env.local --import tsx scripts/ingest.ts",
    "evals": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx evals/run.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.3.2",
    "@langchain/langgraph": "^1.6.0",
    "@langchain/openai": "^1.8.0",
    "@langchain/textsplitters": "^1.0.2",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.40.0",
    "@upstash/vector": "^1.2.3",
    "botid": "^1.5.12",
    "gray-matter": "^4.0.3",
    "marked": "^18.1.2",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
