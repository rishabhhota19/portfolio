{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "content": "tsx scripts/build-content.ts",
    "predev": "npm run content",
    "dev": "next dev",
    "prebuild": "npm run content",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "evals": "python -m evals.run_evals",
    "agent": "python -m uvicorn api.index:app --port 8000 --reload",
    "agent:index": "npm run content && python -m agent.build_index && python -m agent.build_answers",
    "evals:ragas": "python -m evals.ragas_eval",
    "evals:rerank": "python -m evals.rerank_ab",
    "evals:difficulty": "python -m evals.difficulty_eval",
    "evals:load": "python -m evals.load_sim",
    "evals:scope": "python -m evals.scope_eval --full",
    "evals:nav": "python -m evals.navigation_eval",
    "media:deploy": "npx --yes wrangler@4 deploy --config cloudflare/media/wrangler.jsonc",
    "analytics:deploy": "npx --yes wrangler@4 deploy --config cloudflare/analytics/wrangler.jsonc",
    "warm:deploy": "npx --yes wrangler@4 deploy --config cloudflare/warm/wrangler.jsonc"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.11.0",
    "@upstash/redis": "^1.41.0",
    "botid": "^1.5.12",
    "gray-matter": "^4.0.3",
    "marked": "^18.1.3",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
