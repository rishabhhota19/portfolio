# Copy to .env.local for local development, and add the same keys in Vercel → Settings → Environment Variables.
# Locally everything is optional: with no LLM keys the agent runs in mock mode, and logging prints to the console.

# ── LLMs + embeddings (free tiers) ──
GROQ_API_KEY=                     # console.groq.com → API Keys
GOOGLE_GENERATIVE_AI_API_KEY=     # aistudio.google.com/apikey (chat fallback + embeddings for FAISS)

# ── Re-ranking: Cloudflare Workers AI (bge-reranker-base). Optional: without it, results keep the RRF order ──
CF_ACCOUNT_ID=                    # Cloudflare dashboard → Account ID
CF_WORKERS_AI_TOKEN=              # My Profile → API Tokens → "Workers AI" template

# ── Python agent ──
AGENT_SHARED_SECRET=              # random string; the Next.js gateway sends it, the Python API checks it
AGENT_URL=http://127.0.0.1:8000   # local only (npm run agent). Don't set on Vercel.

# ── Security: rate limits + daily budget (Upstash Redis; Vercel Marketplace sets KV_REST_API_* for you) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DAILY_LLM_BUDGET=1000
CHAT_TOKEN_SECRET=                # random string
IP_HASH_SALT=                     # random string
# generate random strings with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ── Logging: Google Sheets via Apps Script (integrations/google-sheets/Code.gs) ──
GOOGLE_SHEETS_WEBHOOK_URL=        # the web app's /exec URL
GOOGLE_SHEETS_SECRET=             # same value as the script's SHARED_SECRET property

# ── Lead emails: Resend ──
RESEND_API_KEY=
LEAD_ALERT_EMAIL=rishabhhota19@gmail.com

# ── Analytics ──
NEXT_PUBLIC_CF_BEACON_TOKEN=      # Cloudflare → Web Analytics → add site → token
