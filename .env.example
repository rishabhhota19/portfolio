# Copy to .env.local for local development, and add the same keys in Vercel → Settings → Environment Variables.
# Locally everything is optional: with no LLM keys the chat shows its "short break" message, and logging prints to the console.

# ── LLMs + embeddings (free tiers) ──
GROQ_API_KEY=                     # console.groq.com → API Keys
GOOGLE_GENERATIVE_AI_API_KEY=     # aistudio.google.com/apikey (Gemini chat models)
OPENROUTER_API_KEY=               # openrouter.ai/keys — free models as extra backups

# ── Cloudflare Workers AI: embeddings (EmbeddingGemma — required for retrieval and the scope check), chat models,
#    and the optional re-ranker. Off in production: it didn't beat RRF here (npm run evals:rerank) ──
CF_ACCOUNT_ID=                    # Cloudflare dashboard → Account ID
CF_WORKERS_AI_TOKEN=              # My Profile → API Tokens → "Workers AI" template (Read is enough)
# ── Private /admin dashboard: a long random password, and a 32+ character secret that signs the session cookie ──
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
RERANKER=                         # leave empty (RRF order); "bge" = use the cross-encoder
ANSWER_BANK=                      # leave empty; "off" = never serve stored answers (the evals set this)

# ── Python agent ──
AGENT_SHARED_SECRET=              # random string; the Next.js gateway sends it, the Python API checks it
AGENT_URL=http://127.0.0.1:8000   # local only (npm run agent). Don't set on Vercel.

# ── Security: rate limits + daily budget (Upstash Redis; Vercel Marketplace sets KV_REST_API_* for you) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DAILY_LLM_BUDGET=3000              # anti-abuse ceiling, above the free models' total (~1,950 answers/day)
DAILY_SUMMARY_BUDGET=400           # chat summaries a day (separate from answers; at most 3 per chat)
CHAT_TOKEN_SECRET=                # random string
IP_HASH_SALT=                     # random string
# generate random strings with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ── Logging: Google Sheets via Apps Script (integrations/google-sheets/Code.gs) ──
GOOGLE_SHEETS_WEBHOOK_URL=        # the web app's /exec URL
GOOGLE_SHEETS_SECRET=             # same value as the script's SHARED_SECRET property
IPINFO_TOKEN=                     # optional: network/company lookup works without it (~1,000/day); token = more

# ── Lead emails: Resend (optional — without it the Sheet's Apps Script emails you each lead) ──
RESEND_API_KEY=
LEAD_ALERT_EMAIL=rishabhhota19@gmail.com

# ── Analytics + monitoring (each is off until set) ──
NEXT_PUBLIC_CF_BEACON_TOKEN=      # Cloudflare → Web Analytics → add site → token (traffic)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=     # cloud.umami.is → Add website → Website ID (custom events: chat_open, lead_submitted, …)
NEXT_PUBLIC_SENTRY_DSN=           # sentry.io → project → Client Keys (DSN). Used by browser, Next.js server and Python agent
SENTRY_ORG=                       # optional, for readable stack traces (source map upload on build)
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=                # sentry.io → Settings → Auth Tokens (keep secret; Vercel only)
