# Copy to .env.local for local development, and add the same keys in Vercel → Project → Settings → Environment Variables.
# Everything is optional locally: with no LLM keys the agent runs in mock mode, and logging prints to the console.

# ── LLM providers (free tiers) ─────────────────────────────────────────────
GROQ_API_KEY=                         # console.groq.com → API Keys
GOOGLE_GENERATIVE_AI_API_KEY=         # aistudio.google.com → Get API key
CF_WORKERS_AI_TOKEN=                  # Cloudflare → My Profile → API Tokens → "Workers AI" template
AI_GATEWAY_API_KEY=                   # optional: Vercel → AI Gateway → API keys (uses the free monthly credit)

# Cloudflare AI Gateway (routes Groq, Gemini and Workers AI through one endpoint with logs + caching)
CF_ACCOUNT_ID=                        # Cloudflare dashboard → right sidebar "Account ID"
CF_GATEWAY_ID=portfolio-agent         # AI → AI Gateway → Create gateway (use this name)
CF_AIG_TOKEN=                         # only if you turn on "Authenticated Gateway"

# Optional model overrides
# GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
# GEMINI_MODEL=gemini-2.5-flash-lite
# WORKERS_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
# VERCEL_AI_GATEWAY_MODEL=google/gemini-2.5-flash-lite

# ── RAG: Upstash Vector (create the index with the BAAI/bge-small-en-v1.5 embedding model) ──
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
# RAG_MIN_SCORE=0.72

# ── Rate limits, daily budget, cooldowns: Upstash Redis (Vercel Marketplace sets KV_REST_API_* for you) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DAILY_LLM_BUDGET=1000

# ── Logging: Google Sheets via Apps Script (integrations/google-sheets/Code.gs) ──
GOOGLE_SHEETS_WEBHOOK_URL=            # the web app's /exec URL
GOOGLE_SHEETS_SECRET=                 # same value as the script's SHARED_SECRET property

# ── Lead emails: Resend ──
RESEND_API_KEY=
LEAD_ALERT_EMAIL=rishabhhota19@gmail.com   # must be your Resend account email until you verify a domain
# RESEND_FROM=Portfolio Agent <onboarding@resend.dev>

# ── Secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ──
CHAT_TOKEN_SECRET=
IP_HASH_SALT=

# ── Analytics ──
NEXT_PUBLIC_CF_BEACON_TOKEN=          # Cloudflare → Web Analytics → Add site → copy the token from the snippet

# ── Local testing ──
# LLM_MOCK=1                          # force the scripted mock model
# FORCE_FAIL=groq,google-ai-studio    # make providers fail on purpose to test fallbacks
